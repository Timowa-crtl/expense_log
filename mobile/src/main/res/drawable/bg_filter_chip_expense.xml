<?xml version="1.0" encoding="utf-8"?>
<!-- The export dialog's chip for an expenses-only filter: expenseColor at 8%, outlined in it. Same shape as bg_filter_chip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14A50000" />
    <stroke
        android:width="1dp"
        android:color="@color/expenseColor" />
    <corners android:radius="14dp" />
</shape>
