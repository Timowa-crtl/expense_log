<?xml version="1.0" encoding="utf-8"?>
<!-- The export dialog's chip for an incomes-only filter: incomeColor at 9%, outlined in it. Same shape as bg_filter_chip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#17008C00" />
    <stroke
        android:width="1dp"
        android:color="@color/incomeColor" />
    <corners android:radius="14dp" />
</shape>
