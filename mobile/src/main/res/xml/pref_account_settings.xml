<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
        android:defaultValue="@bool/default_budget_enable"
        android:key="@string/pref_key_budget_enable"
        android:summary="@string/pref_budget_description"
        android:title="@string/pref_title_budget_enable" />

    <!-- AndroidX EditTextPreference ignores EditText attributes such as inputType: the
         fragment sets the number keyboard in an OnBindEditTextListener, and sets the summary. -->
    <EditTextPreference
        android:defaultValue="0"
        android:dependency="@string/pref_key_budget_enable"
        android:key="@string/pref_key_budget_amount"
        android:title="@string/pref_title_budget_amount" />

    <ListPreference
        android:defaultValue="@string/default_budget_period"
        android:dependency="@string/pref_key_budget_enable"
        android:entries="@array/budget_period_array"
        android:entryValues="@array/pref_budget_period_values"
        android:key="@string/pref_key_budget_period"
        android:negativeButtonText="@null"
        android:positiveButtonText="@null"
        android:title="@string/budget_period" />
</PreferenceScreen>
