<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below, where allowBackup="false" already prevents this. Declared so the two
    Android generations say the same thing rather than relying on one attribute each.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
