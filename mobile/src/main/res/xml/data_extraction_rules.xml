<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. Nothing leaves the device by backup or by device transfer: the database
    holds the user's financial records, and the Dropbox credential is encrypted under a key in this
    device's Keystore, which does not transfer. The app's .edb export is how records move.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
