    <!--About dialog: shown after "Developed by". Points at the source rather than a store
        listing, which is correct from day one for an open-source build.-->
    <!-- The About screen's three links. GitHub is real. The Play and F-Droid listings do not
         exist yet: these are the URLs they will have, built from the package name, so they become
         correct the day the app is published and need no code change then. -->
    <string name="url_google_play" translatable="false">https://play.google.com/store/apps/details?id=de.timowa.expenselog</string>
    <string name="url_f_droid" translatable="false">https://f-droid.org/packages/de.timowa.expenselog</string>
    <string name="url_github" translatable="false">https://github.com/Timowa-crtl/expense_log</string>

    <!--The Dropbox app key is NOT here. It is not in version control at all: set
        dropbox.appKey in local.properties and mobile/build.gradle generates both
        @string/dropbox_key (the "db-" prefixed OAuth redirect scheme the manifest matches on)
        and @string/dropbox_app_key (bare, for Auth.startOAuth2PKCE). Get one from
        https://www.dropbox.com/developers/apps with App Folder access.-->

