    <!-- Not a user-facing setting, and not the rating system's, though it used to live there:
         LocalBackupManager gates the weekly and monthly backups on how long the app has been
         installed. MainActivity writes it once, on first launch. -->
    <string name="pref_key_first_launch_time" translatable="false">pref_key_first_launch_time</string>
    <string name="pref_key_reminder_enable" translatable="false">pref_reminder_enable</string>

    <!-- Not a user-facing setting: records that POST_NOTIFICATIONS has been asked for once on this
         install, so the launch-time request is not repeated. Once the user has denied twice,
         Android auto-denies without a dialog, and the request would otherwise fire (and its denial
         message with it) on every launch and every rotation. See docs/history/RECOVERY_PLAN.md Step 5. -->
    <string name="pref_key_notification_permission_asked" translatable="false">pref_notification_permission_asked</string>

    <!-- Not a user-facing setting: the path of an export staged in the app's own directory while
         the system "Save to..." picker is in front of the user. The picker is another activity, so
         the app can be killed behind it; a static field would not survive that and the export
         would silently do nothing. Cleared as soon as the copy lands or the picker is cancelled. -->
    <string name="pref_key_pending_export_path" translatable="false">pref_pending_export_path</string>
    <string name="pref_key_reminder_frequency" translatable="false">pref_reminder_frequency</string>
    <string name="pref_key_reminder_time" translatable="false">pref_reminder_time</string>
    <string name="pref_key_permission_requested" translatable="false">pref_key_permission_requested</string>
    <string name="pref_key_category_sorting" translatable="false">pref_key_category_sorting</string>
    <string name="pref_key_graph_grouping" translatable="false">pref_key_graph_grouping</string>
    <string name="pref_key_recurring_ended_expanded" translatable="false">pref_key_recurring_ended_expanded</string>

    <!--Default values-->
    <bool name="default_budget_enable">false</bool>
    <!-- "Jan 25, 2016". Must stay in step with PrefManager.DATE_FORMAT_DEFAULT: this is only
         what android:defaultValue gives the ListPreference to pre-select, while PrefManager is
         what actually renders a date when the key is absent.

         This governs the app's own screens only. CSV exports are always ISO 8601 regardless of
         it — see CsvFormatter — so changing this cannot make an export ambiguous. -->
    <string name="default_date_format">0</string>
    <string name="default_time_format">0</string>
    <!-- Monday. The options run Saturday, Sunday, Monday, ... so Monday is 2, not 1.
         Every reader of pref_key_first_day_of_week passes this as its getString fallback:
         nothing calls PreferenceManager.setDefaultValues, so android:defaultValue only
         pre-selects the radio and this string is what actually decides where a week starts
         while the key is absent. FirstDayOfWeekDefaultTest pins it to the Monday label. -->
    <string name="default_first_day_of_week">2</string>
    <string name="default_budget_period">2</string>
    <bool name="default_reminder_enable">true</bool>
    <string name="default_reminder_frequency">0</string>
