<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    android:id="@+id/relativeLayout_LogListFrag"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="de.timowa.expenselog.MainActivity">

    <LinearLayout
        android:id="@+id/layout_incomeExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/textView_listIncome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Income: $44"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/incomeColor"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/textView_listExpense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Expense: -$872"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/expenseColor"
            tools:ignore="HardcodedText" />


    </LinearLayout>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="fill_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/layout_incomeExpense"
        android:background="@color/colorAccent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_logList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/viewDivider"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="@dimen/fab_stack_avoiding_margin"
        android:scrollbars="vertical" />
</RelativeLayout>
