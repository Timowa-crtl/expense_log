<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout_newLogFrag"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    tools:context="de.timowa.expenselog.MainActivity">


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:ignore="UselessParent">

        <LinearLayout
            style="@style/max_layout_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingBottom="@dimen/fab_avoiding_margin"
            android:paddingLeft="@dimen/general_padding"
            android:paddingRight="@dimen/general_padding"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_expense"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="2"
                    android:gravity="center_vertical|right"
                    android:text="@string/expense"
                    android:textColor="@color/darkText"
                    android:textSize="@dimen/expense_income_switch_large_text" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_expense_income"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="12dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:theme="@style/ExpenseIncomeSwitch" />

                <TextView
                    android:id="@+id/textView_income"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="2"
                    android:gravity="center_vertical|left"
                    android:text="@string/income"
                    android:textColor="@color/lightText"
                    android:textSize="@dimen/expense_income_switch_small_text" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider" />

            <LinearLayout
                android:id="@+id/layout_account_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView_accountLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/account"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_accountList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="@integer/new_log_value_column_weight" />
            </LinearLayout>

            <View
                android:id="@+id/view_accounts_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider"
                android:visibility="gone" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/category"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView_tagListItem"
                    style="@style/Widget.AppCompat.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="@integer/new_log_value_column_weight"
                    android:ellipsize="end"
                    android:lines="1"
                    android:paddingBottom="12dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="32dp"
                    android:paddingTop="12dp"
                    android:textAppearance="?android:attr/textAppearanceLarge" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/new_log_row_padding"
                android:paddingTop="@dimen/new_log_row_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/date"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView_logDate"
                    style="@style/Widget.AppCompat.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:text="July 20, 2014"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/textView_logTime"
                    style="@style/Widget.AppCompat.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="30"
                    android:gravity="center"
                    android:text="4:45pm"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/new_log_row_padding"
                android:paddingTop="@dimen/new_log_row_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/amount"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editText_new_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="@integer/new_log_value_column_weight"
                    android:hint="@string/amount"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:nextFocusForward="@+id/editText_new_notes"
                    android:selectAllOnFocus="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/new_log_row_padding"
                android:paddingTop="@dimen/new_log_row_padding">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right|center_vertical"
                    android:text="@string/notes"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editText_new_notes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="@integer/new_log_value_column_weight"
                    android:hint="@string/notes"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="200"
                    android:scrollHorizontally="true"
                    android:selectAllOnFocus="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="@color/newLogDivider" />

            <!-- The series block's header, the same row for creating and editing. Creating (and
                 editing a record outside a series): the Repeat switch. Editing a series entry:
                 the previous / next arrows around the entry's position. Below either, the
                 schedule the rows under it describe; NewLogFragment fills and switches them. -->
            <LinearLayout
                android:id="@+id/layout_seriesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="-8dp"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/button_seriesPrevious"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recurring_previous_entry"
                    android:src="@drawable/ic_chevron_left_32dp"
                    android:visibility="gone"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_repeatToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageView_repeatIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_repeating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:minHeight="40dp"
                            android:text="@string/repeat_transaction"
                            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                            android:textStyle="bold"
                            app:switchPadding="16dp" />
                    </LinearLayout>

                    <!-- "Entry 9 of 13", with the Recurring icon set by NewLogFragment -->
                    <TextView
                        android:id="@+id/textView_seriesInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                        android:textColor="@color/darkText"
                        android:visibility="gone" />

                    <!-- "Monthly on day 17 · 13 entries"; set by NewLogFragment.updateRepeatSummary. -->
                    <TextView
                        android:id="@+id/textView_repeatSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_seriesNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recurring_next_entry"
                    android:src="@drawable/ic_chevron_right_32dp"
                    android:visibility="gone"
                    app:tint="@color/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:paddingTop="@dimen/new_log_row_padding"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView_frequencyLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/every"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <!-- Reads as a sentence, "Every [2] [months]": a narrow count beside a unit
                     wide enough for its whole word. The unit follows the count's plural. -->
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="@integer/new_log_value_column_weight">

                    <EditText
                        android:id="@+id/editText_frequency"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:selectAllOnFocus="true" />

                    <Spinner
                        android:id="@+id/spinner_frequencyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@id/editText_frequency"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/editText_frequency" />
                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_frequency_ending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/new_log_row_padding"
                android:paddingTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textView_frequencyEndingLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="@integer/new_log_label_column_weight"
                    android:gravity="right"
                    android:text="@string/ending"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView_frequencyEndingDate"
                    style="@style/Widget.AppCompat.Spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/new_log_row_item_gap"
                    android:layout_weight="40"
                    android:gravity="center"
                    android:soundEffectsEnabled="false"
                    android:text="July 20, 2014"
                    android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium"
                    tools:ignore="HardcodedText" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="30" />
            </LinearLayout>

            <!-- Why the schedule above can't be saved; shown only then. -->
            <TextView
                android:id="@+id/textView_repeatError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="@dimen/new_log_row_padding"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small"
                android:textColor="@color/errorText"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
